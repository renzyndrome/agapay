# ── Agapay environment ──────────────────────────────────────────────────────
# Copy to .env for local dev. In Dokploy, set these in the app's Environment tab
# (they are passed to the Docker build as build args — Vite inlines VITE_* at
# BUILD time, not runtime).

# Supabase project (shared with the Quest Laguna directory app)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon / publishable key — safe in the browser, RLS protects the data>

# Auth mode.
#   unset / "true"  → DEMO: seeded in-memory data + the Discipler/Admin role
#                     switcher. This is what discipleship.questlaguna.org runs.
#   "false"         → LIVE: real Supabase login, role-based redirects, guards.
#                     Requires the two variables above.
VITE_DEMO_MODE=true

# ── NEVER put these in a VITE_* variable ────────────────────────────────────
# The service-role key bypasses RLS. It is used only by server-side scripts
# (e.g. the Phase 6 member import), never shipped to the browser.
# SUPABASE_SERVICE_ROLE_KEY=<server-only>
